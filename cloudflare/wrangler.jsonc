{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhuvana-booking-api",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://boopathirajak2006.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8787",
    "SUPABASE_URL": "https://YOUR_PROJECT_ID.supabase.co",
    "R2_POSTER_BUCKET": "bhuvana-posters-bucket",
    "MAX_POSTER_SIZE_BYTES": "5242880",
    "WHATSAPP_API_VERSION": "v21.0"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bhuvana-posters-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhuvana-bookings-db",
      "database_id": "c33e932b-9a44-4002-ac5a-9dc47c45c227",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
