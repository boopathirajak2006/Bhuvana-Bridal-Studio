# ==============================================================================
# Bhuvana's Bridal Studio — Supabase Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. In your Supabase Dashboard (https://supabase.com/dashboard):
#    Navigate to: Project Settings -> API.
# 2. Copy the "Project URL" and the public "anon / public" API key.
# 3. DO NOT use or put your "service_role / secret" key here or in frontend code!
#    The service_role key bypasses all Row Level Security.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (safe for browser frontend with RLS enabled)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
